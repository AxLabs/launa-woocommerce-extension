{
  "name": "axlabs/ax402-for-woocommerce",
  "description": "Launa payment gateway for WooCommerce",
  "type": "wordpress-plugin",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "autoload": {
    "classmap": [
      "includes/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Launa\\WC\\Tests\\": "../tests/php/"
    }
  },
  "scripts": {
    "test": "phpunit -c ../phpunit.xml.dist"
  }
}
