# Launa control plane + seller (required for gateway at checkout / seed)
# AX402_* is still read when the matching LAUNA_* variable is unset.
# Production: https://api.launa.io
# Staging (exchange-rates live here): https://api.staging.launa.io
LAUNA_BASE_URL=https://api.launa.io
LAUNA_API_KEY=
LAUNA_PAY_TO_ADDRESS=0x
# Hedera account id (0.0.x) when enabling Hedera settlement tokens — seeded into WP
# LAUNA_PAY_TO_HEDERA_ACCOUNT_ID=0.0.123456
# WalletConnect / Reown Cloud project id (required for Hedera shopper wallets) — seeded into WP
# LAUNA_WALLETCONNECT_PROJECT_ID=
LAUNA_NETWORK=sepolia

# Buyer wallet for programmatic E2E pay (funded USDC on the chosen network)
LAUNA_EVM_PRIVATE_KEY=

# Public store origin for E2E (ngrok / Cloudflare Tunnel / staging).
# Must match WP_HOME and Launa API upstream_base_url.
# Example: https://your-subdomain.ngrok-free.dev
WP_BASE_URL=

# Optional: pin a seeded product for E2E (otherwise first catalog product is used)
# E2E_PRODUCT_ID=

# UCP for agents is on by default after seed. Set to no to disable, then re-run npm run env:e2e.
# LAUNA_UCP_ENABLED=no
